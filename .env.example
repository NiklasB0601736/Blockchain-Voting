# Blockchain Voting System - Environment Configuration

# Admin-Schlüssel für Wahl-Verwaltung
ADMIN_KEY=your_secret_admin_key_here

# Flask Konfiguration
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Blockchain Konfiguration
BLOCKCHAIN_NAME=voting_blockchain
BLOCKCHAIN_PROOF_DIFFICULTY=5  # Anzahl der führenden Nullen für Proof-of-Work

# MetaMask / Ethereum Konfiguration
ETHEREUM_NETWORK=goerli
ETHEREUM_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY

# zkSync Konfiguration
ZKSYNC_NETWORK=zkSyncTestnet
ZKSYNC_RPC_URL=https://testnet.era.zksync.dev

# Semaphore Konfiguration
SEMAPHORE_TREE_DEPTH=20
SEMAPHORE_GROUP_ID=0

# Smart Contract Adressen
VOTING_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private Keys (NUR für Development!)
# PRIVATE_KEY=your_private_key_here

# Logging
LOG_LEVEL=INFO
LOG_FILE=voting_system.log
